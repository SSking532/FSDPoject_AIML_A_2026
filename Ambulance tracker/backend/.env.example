# PostgreSQL connection (recommended). Leave unset to fall back to a local SQLite file.
DATABASE_URL=postgresql+psycopg://ambulance:ambulance@localhost:5432/smart_ambulance
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SEED_DEMO_DATA=true
LOCATION_STALE_SECONDS=120
