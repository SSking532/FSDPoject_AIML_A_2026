# false = talk to the FastAPI backend (recommended). true = run on built-in demo data, no backend needed.
VITE_USE_MOCK_DATA=false
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# Optional: a different map tile server (default is the free CARTO/OpenStreetMap basemap)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
